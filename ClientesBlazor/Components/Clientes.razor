@page "/clientes"
@rendermode InteractiveServer
@using ClientesBlazor.Models
@using ClientesBlazor.Services
@inject ClienteService Servicio

<PageTitle>Clientes</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Clientes</h1>
    <button class="btn btn-primary" @onclick="NuevoCliente">Agregar cliente</button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@tipoMensaje alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => mensaje = null"></button>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (clientes.Count == 0)
{
    <div class="alert alert-secondary">Todavía no hay clientes registrados. Usa "Agregar cliente" para crear el primero.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>CUI</th>
                    <th>NIT</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>@c.Id_cliente</td>
                    <td>@c.CUI</td>
                    <td>@c.nit</td>
                    <td>@c.Nombres</td>
                    <td>@c.Apellidos</td>
                    <td>@c.direccion</td>
                    <td>@c.Telefono</td>
                    <td>@c.fecha_nacimiento?.ToString("dd/MM/yyyy")</td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarCliente(c)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirEliminar(c)">Eliminar</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@* ===== Modal agregar / modificar ===== *@
@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="clienteActual" OnValidSubmit="Guardar" FormName="formCliente">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(esNuevo ? "Agregar cliente" : "Modificar cliente")</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">CUI</label>
                                <InputText class="form-control" @bind-Value="clienteActual.CUI" maxlength="13" />
                                <ValidationMessage For="() => clienteActual.CUI" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="clienteActual.nit" />
                                <ValidationMessage For="() => clienteActual.nit" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Nombres" />
                                <ValidationMessage For="() => clienteActual.Nombres" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Apellidos" />
                                <ValidationMessage For="() => clienteActual.Apellidos" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control" @bind-Value="clienteActual.direccion" />
                                <ValidationMessage For="() => clienteActual.direccion" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Telefono" maxlength="8" />
                                <ValidationMessage For="() => clienteActual.Telefono" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" @bind-Value="clienteActual.fecha_nacimiento" />
                                <ValidationMessage For="() => clienteActual.fecha_nacimiento" class="text-danger small" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar cambios")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===== Modal confirmar eliminación ===== *@
@if (clienteAEliminar is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar cliente</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => clienteAEliminar = null"></button>
                </div>
                <div class="modal-body">
                    ¿Seguro que quieres eliminar a <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>? Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => clienteAEliminar = null">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private Cliente clienteActual = new();
    private Cliente? clienteAEliminar;
    private bool cargando = true;
    private bool mostrarModal;
    private bool esNuevo;
    private bool guardando;
    private string? mensaje;
    private string tipoMensaje = "success";

    protected override async Task OnInitializedAsync() => await CargarClientes();

    private async Task CargarClientes()
    {
        try
        {
            cargando = true;
            clientes = await Servicio.ObtenerTodosAsync();
        }
        catch (Exception)
        {
            Mostrar("No se pudo conectar con la API. Verifica que esté en ejecución y que la URL sea correcta.", "danger");
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoCliente()
    {
        clienteActual = new Cliente();
        esNuevo = true;
        mostrarModal = true;
    }

    private void EditarCliente(Cliente c)
    {
        // Copia para no modificar la fila de la tabla antes de guardar
        clienteActual = new Cliente
        {
            Id_cliente = c.Id_cliente, CUI = c.CUI, nit = c.nit, Nombres = c.Nombres,
            Apellidos = c.Apellidos, direccion = c.direccion, Telefono = c.Telefono,
            fecha_nacimiento = c.fecha_nacimiento
        };
        esNuevo = false;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        guardando = true;
        try
        {
            var ok = esNuevo
                ? await Servicio.CrearAsync(clienteActual)
                : await Servicio.ActualizarAsync(clienteActual);

            if (ok)
            {
                Mostrar(esNuevo ? "Cliente agregado correctamente." : "Cliente modificado correctamente.", "success");
                mostrarModal = false;
                await CargarClientes();
            }
            else
            {
                Mostrar("No se pudo guardar el cliente. Revisa los datos e intenta de nuevo.", "danger");
            }
        }
        catch (Exception)
        {
            Mostrar("Error de conexión con la API.", "danger");
        }
        finally
        {
            guardando = false;
        }
    }

    private void PedirEliminar(Cliente c) => clienteAEliminar = c;

    private async Task ConfirmarEliminar()
    {
        if (clienteAEliminar is null) return;
        try
        {
            var ok = await Servicio.EliminarAsync(clienteAEliminar.Id_cliente);
            Mostrar(ok ? "Cliente eliminado correctamente." : "No se pudo eliminar el cliente.", ok ? "success" : "danger");
        }
        catch (Exception)
        {
            Mostrar("Error de conexión con la API.", "danger");
        }
        clienteAEliminar = null;
        await CargarClientes();
    }

    private void Mostrar(string texto, string tipo)
    {
        mensaje = texto;
        tipoMensaje = tipo;
    }
}
